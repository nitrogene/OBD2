  "stackup_definitions": {
    "4_layer_jlc2313": {
      "total_thickness_mm": 1.60,
      "epsilon_r": 4.05,
      "prepreg_top_inner1_mm": 0.11,
      "core_inner1_inner2_mm": 1.26,
      "prepreg_inner2_bottom_mm": 0.11,
      "layer_distance_to_inner1_mm": {
        "TopLayer": 0.11,
        "1": 0.11,
        "Inner1": 0.0,
        "15": 0.0,
        "Inner2": 1.26,
        "16": 1.26,
