{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JLCPCB DFM & SMT Design Rules",
  "description": "Seuils de tolérance et capacités d'usinage / assemblage standard JLCPCB (PCB 4 couches standard JLC2313, épaisseur 1.6 mm, cuivre 1 oz)",
  "vendor": "JLCPCB",
  "stackup": "JLC2313",
  "pcb_rules": {
    "soldermask_bridge": {
      "min_green_mm": 0.10,
      "min_other_color_mm": 0.12,
      "danger_threshold_mm": 0.08,
      "description": "Largeur minimale du pont de vernis épargne entre pastilles adjacentes pour éviter le décollement (gang mask) et les ponts d'étain"
    },
    "via_to_pad": {
      "min_clearance_mm": 0.15,
      "danger_threshold_mm": 0.05,
      "allow_thermal_pad_vias": true,
      "description": "Distance minimale cuivre-à-cuivre entre pastille CMS et via non bouché pour prévenir le siphonnage d'étain (solder wicking)"
    },
    "silkscreen": {
      "min_to_pad_clearance_mm": 0.15,
      "min_to_hole_clearance_mm": 0.15,
      "min_text_stroke_mm": 0.15,
      "recommended_text_stroke_mm": 0.18,
      "min_text_height_mm": 0.80,
      "default_font_height_mm": 1.00,
      "default_stroke_width_mm": 0.15,
      "pad_clearance_mm": 0.20,
      "text_clearance_mm": 0.20,
      "board_edge_clearance_mm": 0.40,
      "dense_zone_crown_max_mm": 1.20,
      "voronoi_safety_margin_mm": 0.40,
      "description": "Dégagement sérigraphie face aux ouvertures de vernis et perçages pour éviter le rognage automatique (auto-clipping)"
    },
    "copper": {
      "min_trace_width_mm": 0.09,
      "min_trace_spacing_mm": 0.09,
      "min_copper_to_board_edge_mm": 0.30,
      "danger_copper_to_edge_mm": 0.20,
      "description": "Largeur de piste minimale (3.5 mils) et recul de cuivre par rapport au contour de fraisage CNC / rainurage en V"
    },
    "drilling": {
      "min_via_drill_mm": 0.30,
      "min_annular_ring_mm": 0.13,
      "danger_annular_ring_mm": 0.10,
      "min_pad_drill_mm": 0.60,
      "description": "Diamètre de perçage minimal et bague de cuivre minimale (5 mils)"
    }
  },
  "smt_rules": {
    "spacing": {
      "min_component_to_component_mm": 0.50,
      "danger_component_to_component_mm": 0.25,
      "description": "Dégagement minimal entre boîtiers CMS pour la liberté de passage des buses de placement Pick & Place"
    },
    "conveyor": {
      "min_rail_margin_mm": 3.0,
      "description": "Bord libre sans composant CMS sur les côtés longs pour maintien sur les rails de convoyeur de refusion SMT"
    },
    "fiducials": {
      "required_count": 3,
      "min_diameter_mm": 1.0,
      "min_clearance_mm": 1.0,
      "description": "Repères optiques de cadrage pour machine Pick & Place automatique"
    }
  },
  "ipc_courtyard_margins_mm": {
    "default": 0.30,
    "0402": 0.25,
    "0603": 0.30,
    "0805": 0.30,
    "1206": 0.35,
    "1812": 0.40,
    "SOD-323": 0.30,
    "SOD-123": 0.35,
    "SOD-123FL": 0.35,
    "SOT-23": 0.35,
    "SOT-223-4": 0.45,
    "SOIC-8": 0.40,
    "SMA": 0.40,
    "SMB": 0.40,
    "SMD_IND_7X7": 0.40,
    "MODULE_ESP32_S3": 0.50,
    "USB_C_16P": 0.40,
    "CONN_JST_XH_5P_90": 0.50,
    "HEADER_1X2_2.54": 0.40,
    "HEADER_1X3_2.54": 0.40,
    "JUMPER_1X2_2.54": 0.40,
    "TACT_SWITCH_SMD": 0.40,
    "TEST_PAD": 0.35
