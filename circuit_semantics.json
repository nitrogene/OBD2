{
  "$schema": "./schemas/circuit_semantics.schema.json",
  "project": "OBD2-Scanner-ESP32",
  "version": "1.0",
  "date_modified": "2026-09-26",
  "description": "Référentiel sémantique exhaustif des rôles, contraintes et politiques de substituabilité des composants du Scanner OBD-II ESP32.",
  "power_rails": {
    "+12V": {
      "nominal_v": 12.0,
      "max_v": 16.0,
      "source": "J1.1",
      "type": "battery_raw"
    },
    "+12V_FUSED": {
      "nominal_v": 12.0,
      "max_v": 16.0,
      "source": "F1.Out",
      "type": "protected_fused"
    },
    "+12V_PROT": {
      "nominal_v": 12.0,
      "clamped_v": 26.0,
      "source": "Q1.Drain",
      "type": "protected_anti_reverse"
    },
    "+5V": {
      "nominal_v": 5.0,
      "max_ripple_mv": 50,
      "source": "U4.PH_L1",
      "type": "buck_regulated"
    },
    "VBUS_5V": {
      "nominal_v": 5.0,
      "source": "J2.VBUS",
      "type": "usb_power"
    },
    "3.3V_PRE": {
      "nominal_v": 3.3,
      "source": "U5.VOUT",
      "type": "ldo_raw_output"
    },
    "3.3V": {
      "nominal_v": 3.3,
      "noise_sensitive": true,
      "source": "FB1.Out",
      "type": "ldo_filtered_logic"
    },
    "GND": {
      "nominal_v": 0.0,
      "type": "ground_reference"
    }
  },
  "functional_blocks": {
    "protection_12v": {
      "title": "Protection 12V, Filtrage & Anti-Inversion",
      "description": "Protection contre les surtensions d'alternateur (Load-Dump), inversion de polarité et surintensités habitacle.",
      "components": ["J1", "F1", "D1", "Q1", "Q2", "R5", "R7", "D3", "R14", "R17"]
    },
    "buck_5v": {
      "title": "Convertisseur Buck 12V -> 5V (570 kHz)",
      "description": "Abaisseur de tension synchrone à haut rendement (>85%) générant le rail 5V pour le transceiver CAN et le LDO 3.3V.",
      "components": ["U4", "L1", "D2", "C5", "C7", "C8", "C16", "C14", "C17", "R9", "R10", "R11", "R19", "R20", "C9", "C13"]
    },
    "ldo_3v3": {
      "title": "Régulateur Linéaire LDO 3.3V Faible Bruit",
      "description": "Régulateur LDL1117 et perle de ferrite FB1 générant une alimentation propre pour le SoC radio ESP32-S3.",
      "components": ["U5", "C6", "FB1"]
    },
    "usbc_interface": {
      "title": "Interface USB-C, Alimentation Banc & ESD",
      "description": "Port USB-C natif (D+/D-) pour flash/debug, configuration CC1/CC2, réservoir C18 et alimentation autonome banc via D4.",
      "components": ["J2", "D4", "C18", "U6", "U7", "R3", "R4"]
    },
    "can_transceiver": {
      "title": "Transceiver CAN Haute Vitesse (ISO 11898-2)",
      "description": "Étage physique différentiel TJA1051T avec terminaison 120 ohms déconnectable et protections transitoires NUP2105L.",
      "components": ["U2", "U8", "R8", "JP1", "C3", "C15"]
    },
    "kline_transceiver": {
      "title": "Transceiver K-Line 12V (ISO 9141-2 / ISO 14230)",
      "description": "Liaison mono-fil bidirectionnelle 12V L9637D avec pull-up normalisée R16 // R18 (500 ohms, 2x1k 1206) débrayable par cavalier JP2 et protections TVS 24V.",
      "components": ["U3", "D5", "R1", "R2", "R16", "R18", "JP2", "C4"]
    },
    "esp32_mcu": {
      "title": "SoC ESP32-S3 & Périphériques Radio",
      "description": "Cœur de traitement 240 MHz double cœur, Wi-Fi 2.4 GHz, BLE 5.0, bouton reset, pull-up strapping R21 et voyant d'état LED1.",
      "components": ["U1", "C1", "C2", "C11", "C12", "R15", "R21", "SW1", "LED1", "R6"]
    },
    "vbat_monitoring": {
      "title": "Monitoring Tension Batterie (ADC1)",
      "description": "Pont diviseur 100k/12k avec filtrage HF C10 et clamp de protection D6 raccordé sur ADC1 de l'ESP32.",
      "components": ["R12", "R13", "C10", "D6"]
    },
    "test_points": {
      "title": "Points de Test Cuivre (Mires de mesure)",
      "description": "Pads de test pour diagnostic oscilloscope, voltmètre et forçage bootloader.",
      "components": ["TP1", "TP2", "TP3", "TP4", "TP5", "TP6", "TP7", "TP8", "TP9", "TP10", "TP11", "TP12", "TP13", "TP14", "TP15"]
    }
  },
