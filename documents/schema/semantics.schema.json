{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semantics.schema.json",
  "title": "Circuit Semantics Schema",
  "description": "Référentiel sémantique des rôles, blocs fonctionnels, rails d'alimentation et règles de substituabilité des composants.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "date_modified": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "power_rails": {
      "type": "object",
      "description": "Définition des rails d'alimentation, tensions nominales et sources.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nominal_v": { "type": "number" },
          "max_v": { "type": "number" },
          "clamped_v": { "type": "number" },
          "max_ripple_mv": { "type": "number" },
          "source": { "type": "string" },
          "type": { "type": "string" },
          "noise_sensitive": { "type": "boolean" }
        },
        "required": ["nominal_v", "type"]
      }
    },
    "functional_blocks": {
      "type": "object",
      "description": "Regroupement fonctionnel des composants du schéma.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "components": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["title", "description", "components"]
      }
    },
    "components": {
      "type": "object",
      "description": "Détails sémantiques et contraintes de chaque composant.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "block": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" },
          "value": { "type": ["string", "null"] },
          "footprint": { "type": "string" },
          "substitutability": { "type": "string" },
          "constraints": { "type": "object" }
        },
        "required": ["block", "role"]
      }
    }
  },
  "required": ["project", "version", "power_rails", "functional_blocks", "components"]
}
